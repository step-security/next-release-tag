{
  "name": "next-release-tag",
  "version": "6.6.0",
  "description": "Github Action to generate next Release Tag",
  "homepage": "https://github.com/step-security/next-release-tag#readme",
  "license": "MIT",
  "author": "step-security",
  "scripts": {
    "build": "tsdown",
    "dist": "npm run lint:ci && npm run typecheck && npm test && npm run build",
    "lint": "oxlint --fix",
    "lint:ci": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "axios": "^1.18.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsdown": "0.22.12",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  }
}
